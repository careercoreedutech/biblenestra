{
  "expo": {
    "name": "BibleNestra",
    "slug": "biblenestra",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "newArchEnabled": false,
    "backgroundColor": "#0e0c0b",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash-white.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "ios": {
      "supportsTablet": false,
      "infoPlist": {
        "NSMicrophoneUsageDescription": "BibleNestra uses the microphone to record sermons and teachings in Sermon Studio.",
        "UIBackgroundModes": [
          "audio"
        ]
      },
      "bundleIdentifier": "com.biblenestra.app"
    },
    "android": {
      "package": "com.biblenestra.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0e0c0b"
      },
      "permissions": [
        "RECORD_AUDIO"
      ],
      "googleServicesFile": "./google-services.json"
    },
    "plugins": [
      "expo-asset",
      "expo-font",
      [
        "expo-build-properties",
        {
          "android": {
            "kotlinVersion": "1.9.25"
          }
        }
      ],
      "expo-video",
      [
        "expo-av",
        {
          "microphonePermission": "BibleNestra uses the microphone to record sermons and teachings in Sermon Studio."
        }
      ],
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-1100393518413611~3976794982",
          "iosAppId": "ca-app-pub-3940256099942544~1458002511",
          "userTrackingUsageDescription": "This identifier is used to show you more relevant ads that support BibleNestra."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#C9A45C"
        }
      ],
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "BibleNestra uses your photo library so you can share photos and videos with the community in Socials.",
          "cameraPermission": "BibleNestra uses the camera so you can capture photos and videos to share in Socials."
        }
      ],
      "react-native-compressor",
      [
        "react-native-android-widget",
        {
          "fonts": [
            "./node_modules/@expo-google-fonts/newsreader/500Medium/Newsreader_500Medium.ttf",
            "./node_modules/@expo-google-fonts/newsreader/500Medium_Italic/Newsreader_500Medium_Italic.ttf"
          ],
          "widgets": [
            {
              "name": "DailyScripture",
              "label": "Daily Scripture",
              "description": "Today's verse with a sunrise photo. Tap to read Daily Bread.",
              "minWidth": "110dp",
              "minHeight": "110dp",
              "targetCellWidth": 2,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 86400000
            },
            {
              "name": "PrayerOfTheDay",
              "label": "Prayer of the Day",
              "description": "A one-line prayer for today. Tap to pray.",
              "minWidth": "250dp",
              "minHeight": "110dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 86400000
            },
            {
              "name": "ReadingProgress",
              "label": "Reading Progress",
              "description": "My Bible Journey: your reading plan progress. Tap to continue reading.",
              "minWidth": "250dp",
              "minHeight": "110dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 86400000
            },
            {
              "name": "SpiritualCompanion",
              "label": "Spiritual Companion",
              "description": "Read Bible, Pray, Listen and Community in one tap.",
              "minWidth": "250dp",
              "minHeight": "250dp",
              "targetCellWidth": 4,
              "targetCellHeight": 4,
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 86400000
            }
          ]
        }
      ]
    ],
    "owner": "dental112",
    "scheme": "biblenestra",
    "extra": {
      "eas": {
        "projectId": "6ac74538-b08d-4329-94f2-225a301f4eda"
      }
    }
  }
}
