{
  "expo": {
    "name": "BibleNestra",
    "slug": "biblenestra",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "newArchEnabled": false,
    "backgroundColor": "#0e0c0b",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0e0c0b"
    },
    "ios": {
      "supportsTablet": false
    },
    "android": {
      "package": "com.biblenestra.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0e0c0b"
      }
    },
    "plugins": [
      "expo-asset",
      "expo-font",
      [
        "expo-build-properties",
        {
          "android": {
            "kotlinVersion": "1.9.25"
          }
        }
      ],
      "expo-video"
    ],
    "extra": {
      "eas": {
        "projectId": "30e35cb8-13b4-47d3-8257-aca31fd44f2c"
      }
    },
    "owner": "somavarapuakash"
  }
}
