{
  "expo": {
    "name": "BibleNestra",
    "slug": "biblenestra",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "newArchEnabled": false,
    "backgroundColor": "#0e0c0b",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0e0c0b"
    },
    "ios": {
      "supportsTablet": false,
      "infoPlist": {
        "NSMicrophoneUsageDescription": "BibleNestra uses the microphone to record sermons and teachings in Sermon Studio."
      }
    },
    "android": {
      "package": "com.biblenestra.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0e0c0b"
      },
      "permissions": [
        "RECORD_AUDIO"
      ]
    },
    "plugins": [
      "expo-asset",
      "expo-font",
      [
        "expo-build-properties",
        {
          "android": {
            "kotlinVersion": "1.9.25"
          }
        }
      ],
      "expo-video",
      [
        "expo-av",
        {
          "microphonePermission": "BibleNestra uses the microphone to record sermons and teachings in Sermon Studio."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "94300823-7f8f-465c-8484-af28faf19fa7"
      }
    },
    "owner": "somavarapuakashs-team"
  }
}