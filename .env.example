# BibleNestra — backend configuration (copy to .env and fill in; Metro reads EXPO_PUBLIC_* at start,
# so restart `expo start` after changing them).
#
# Modes
#   local       leave EXPO_PUBLIC_API_URL empty → everything stays on the device (no account)
#   online      EXPO_PUBLIC_API_URL + EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY → Clerk sign-in, data from the API
#   dev-online  EXPO_PUBLIC_API_URL + EXPO_PUBLIC_DEV_USER (development builds only) → no Clerk; requests
#               send `X-Dev-User: <id>` to a Worker running with AUTH_DEV_MODE=true
#
# Web preview shortcut (dev only, overrides the env):  http://localhost:8081/?api=http://localhost:8787&devUser=alice
# and `?api=local` forces local mode.

# Cloudflare Worker base URL, no trailing slash. e.g. https://biblenestra-api.<you>.workers.dev
EXPO_PUBLIC_API_URL=

# Clerk → API keys → Publishable key (pk_test_… / pk_live_…)
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=

# Development only — ignored in production builds. Any id, e.g. alice
EXPO_PUBLIC_DEV_USER=
